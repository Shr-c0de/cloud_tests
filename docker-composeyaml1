  get-server:
    build:
      context: .
      dockerfile: ./server/Dockerfile.get
    expose:
      - "8001"
    depends_on:
      - postgres
    networks:
      - app

  post-server:
    build:
      context: .
      dockerfile: ./server/Dockerfile.post
    expose:
      - "50051"
      - "8001"
    depends_on:
      - bulker
    networks:
      - app

volumes:
  postgres_data:

networks:
  app: