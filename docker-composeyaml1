services:
  nginx:
    image: nginx:latest
    ports:
      - "8000:8000"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro,Z
    networks:
      - app
    depends_on:
      - get-server
      - post-server

  postgres:
    image: postgres:18
    environment:
      POSTGRES_DB: cars
      POSTGRES_USER: shreyas
      POSTGRES_PASSWORD: password

    volumes:
      - postgres_data:/var/lib/postgresql
    networks:
      - app
    
  bulker:
    build:
      context: .
      dockerfile: bulker/Dockerfile
    expose:
      - "50051"
    depends_on:
      - postgres
    networks:
      - app

